# 복사해서 사용: cp .env.example .env
# 실제 키는 절대 커밋하지 않는다. 서버 전용 키에 NEXT_PUBLIC_ 접두사 금지 (AGENTS.md)

# Prisma Postgres 연결 문자열 (ADR-0013) — 서버 전용
# 즉시 발급: npx create-db@latest   (24시간 임시. 출력된 claim URL로 클레임하면 영구 보존)
# 영구 DB:  https://console.prisma.io 에서 생성 후 direct/pooled 연결 문자열 복사
# Vercel 등 서버리스에는 풀러 엔드포인트(pooled.db.prisma.io) 사용을 권장한다
DATABASE_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# 공공데이터포털 개인/프로젝트 서비스키 (서버 전용)
# API별 활용신청은 각각 필요하지만 승인 시 같은 키를 선택해 함께 사용한다.
PUBLIC_DATA_SERVICE_KEY=""

# 카카오맵 JavaScript SDK 앱 키 (클라이언트 노출 허용) — FR-6 지도
NEXT_PUBLIC_KAKAO_MAP_KEY=""

# 카카오 REST API 키 (서버 전용) — 지오코딩·FR-7 출동 경로
KAKAO_REST_KEY=""
