# 복사해서 사용: cp .env.example .env
# 실제 키는 절대 커밋하지 않는다. 서버 전용 키에 NEXT_PUBLIC_ 접두사 금지 (AGENTS.md)

# SQLite 로컬 DB (ADR-0004) — npx prisma db push로 생성
DATABASE_URL="file:./prisma/dev.db"

# 기상청 단기예보·특보 (공공데이터포털, 서버 전용) — FR-1 트리거
KMA_SERVICE_KEY=""

# 국토부 건축HUB 건축물대장 (공공데이터포털, 서버 전용) — FR-2 건물 취약도
BLDG_HUB_SERVICE_KEY=""

# 카카오맵 JavaScript SDK 앱 키 (클라이언트 노출 허용) — FR-6 지도
NEXT_PUBLIC_KAKAO_MAP_KEY=""

# 카카오 REST API 키 (서버 전용) — 지오코딩·FR-7 출동 경로
KAKAO_REST_KEY=""
