// 데이터 모델 단일 원본 (ADR-0013: Prisma Postgres + Prisma 7, ADR-0004 대체)
//
// ⚠️ 상태값은 String으로 둔다.
//  - 유효한 값 집합은 src/lib/domain.ts의 as const 상수가 정의하고 가드가 검증한다.
//  - Postgres는 enum을 지원하지만, 값을 추가할 때마다 마이그레이션이 필요하고 이미 도메인
//    가드가 방어선 역할을 하므로 v0에서는 String을 유지한다 (ADR-0013 결과 항목).
//  - reasons 등 구조화 데이터는 JSON 직렬화 문자열로 저장한다 (Json 타입 전환은 후속 과제).
//
// 개인정보 원칙 (PRD §8): "건물은 진짜, 사람은 가짜" — Building은 실제 건축물대장 값,
// Subject는 합성 인물만. 실명·실인물 데이터 저장 절대 금지.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 담당자(생활지원사) / 관리자(전담사회복지사) — PRD §4
model Worker {
  id                String             @id @default(cuid())
  name              String
  phone             String?
  role              String             @default("WORKER") // domain.ts WorkerRole: WORKER | MANAGER
  archivedAt        DateTime?
  subjects          Subject[]
  checkEvents       CheckEvent[]
  notifications     Notification[]     @relation("NotificationRecipient")
  pushSubscriptions PushSubscription[]

  @@index([role, archivedAt])
}

// 건물 — 건축HUB 건축물대장 실데이터 (FR-2)
model Building {
  id              String    @id @default(cuid())
  address         String // 지번 주소 (건축물대장 platPlc)
  roadAddress     String? // 도로명 주소 (newPlatPlc)
  lat             Float
  lng             Float
  builtYear       Int? // 사용승인 연도 (useAprDay) — 1980년 이전 ×2.0 가중 (weights.ts)
  isDetached      Boolean   @default(false) // 단독주택 여부 ×1.4 (주용도명 기준, bldg-hub/mapping.ts)
  structure       String? // 구조명 (예: 벽돌구조·슬레이트) — 위험 사유 표시용
  hasTopFloorUnit Boolean   @default(false) // 최상층/옥탑 ×2.0 — 대장에는 없는 가구 속성, 시드가 합성
  // ── 추적 가능성 ("건물은 진짜" 증빙, ADR-0012) — 모두 건축HUB getBrTitleInfo 응답값 ──
  mgmBldrgstPk    String?   @unique // 건축물대장 관리번호
  mainPurpose     String? // 주용도명 (mainPurpsCdNm)
  roof            String? // 지붕명 (roofCdNm)
  groundFloors    Int? // 지상층수 (grndFlrCnt)
  bjdongCode      String? // 법정동코드 10자리 (sigunguCd + bjdongCd)
  subjects        Subject[]
}

// 돌봄 대상자 — 합성 데이터만 (PRD §3 비목표: 실명 데이터 금지)
model Subject {
  id                String               @id @default(cuid())
  name              String // 합성 이름 (예: 김○○)
  birthYear         Int
  phone             String? // 합성 번호
  livesAlone        Boolean              @default(false)
  hasMobilityIssue  Boolean? // null = 데이터 없음 (가중 미적용)
  hasChronicDisease Boolean?
  hasAircon         Boolean? // null = 미확인. false → 지원사업 연계 플래그 (FR-11)
  airconBroken      Boolean              @default(false) // 방문 발견 → 익일 가중 (FR-8)
  archivedAt        DateTime?
  building          Building             @relation(fields: [buildingId], references: [id])
  buildingId        String
  worker            Worker               @relation(fields: [workerId], references: [id])
  workerId          String
  assessments       RiskAssessment[]
  dayStatuses       HouseholdDayStatus[]
  checkEvents       CheckEvent[]
  notifications     Notification[]

  @@index([workerId, archivedAt])
}

// 경보일 — F1 트리거가 생성. 비경보일에는 행이 없다 (침묵이 스펙)
model AlertDay {
  id            String               @id @default(cuid())
  date          String               @unique // "YYYY-MM-DD" (KST)
  level         String // domain.ts AlertLevel: ADVISORY | WARNING | EMERGENCY
  feelsLikeMax  Float // 당일 최고 체감온도
  isDemo        Boolean              @default(false) // 관리자 38도 데모 토글로 만든 경보만 안전하게 초기화
  regionCode    String? // 읍면동 코드 (기상청 격자 매핑용)
  assessments   RiskAssessment[]
  dayStatuses   HouseholdDayStatus[]
  checkEvents   CheckEvent[]
  notifications Notification[]
}

// 대상자별 당일 위험도 평가 — F2 스코어링 결과 스냅샷
model RiskAssessment {
  id         String   @id @default(cuid())
  alertDay   AlertDay @relation(fields: [alertDayId], references: [id])
  alertDayId String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  subjectId  String
  score      Float
  grade      Int // domain.ts RiskGrade: 1(초고위험) | 2 | 3
  reasons    String // JSON string[] — 스코어링 엔진의 위험 사유 (UI에 그대로 표시)

  @@unique([alertDayId, subjectId])
}

// 가구별 당일 상태머신 — F4 에스컬레이션 (docs/architecture.md §4)
model HouseholdDayStatus {
  id           String    @id @default(cuid())
  alertDay     AlertDay  @relation(fields: [alertDayId], references: [id])
  alertDayId   String
  subject      Subject   @relation(fields: [subjectId], references: [id])
  subjectId    String
  status       String    @default("UNCHECKED") // domain.ts HouseholdStatus
  callAttempts Int       @default(0) // 무응답 2회(30분 간격) → 방문 큐 승격
  promotedAt   DateTime? // 방문 큐 승격 시각
  updatedAt    DateTime  @updatedAt

  @@unique([alertDayId, subjectId])
}

// 확인 기록 — 전화/방문 원터치 기록 원장 (F4)
model CheckEvent {
  id         String   @id @default(cuid())
  alertDay   AlertDay @relation(fields: [alertDayId], references: [id])
  alertDayId String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  subjectId  String
  worker     Worker   @relation(fields: [workerId], references: [id])
  workerId   String
  kind       String // domain.ts CheckKind: CALL | VISIT
  result     String // domain.ts CallResult | VisitResult
  memo       String? // 담당자가 남긴 통화·방문 메모 — 관리자 상세와 다음 방문의 히스토리에서 읽는다
  createdAt  DateTime @default(now())
}

// 알림 사건 원장 — 인앱 피드와 Web Push가 같은 행을 사용한다 (ADR-0017)
model Notification {
  id            String    @id @default(cuid())
  eventKey      String    @unique // 재발령·HTTP 재시도에도 한 번만 생성
  type          String // domain.ts NotificationType
  cause         String? // domain.ts NotificationCause (승격만)
  alertDay      AlertDay  @relation(fields: [alertDayId], references: [id], onDelete: Cascade)
  alertDayId    String
  recipient     Worker    @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId   String
  subject       Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId     String?
  title         String
  body          String
  href          String
  availableAt   DateTime // 오전 요약은 08:00 KST, 수동 데모·승격은 즉시
  expiresAt     DateTime // 해당 경보일이 지나면 늦은 Push를 보내지 않는다
  createdAt     DateTime  @default(now())
  readAt        DateTime?
  pushClaimedAt DateTime? // 동시 발송기의 중복 Push 방지용 임시 claim
  pushSentAt    DateTime?
  pushAttempts  Int       @default(0)
  lastPushError String?

  @@index([recipientId, availableAt])
  @@index([pushSentAt, availableAt, expiresAt])
}

// 브라우저별 Push API 구독 — 공개 endpoint와 암호화 키, 소유 계정만 저장한다 (ADR-0017)
model PushSubscription {
  id        String   @id @default(cuid())
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  workerId  String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerId])
}
