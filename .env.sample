# 복사해서 사용: cp .env.sample .env
# 실제 키는 절대 커밋하지 않는다. 서버 전용 키에 NEXT_PUBLIC_ 접두사 금지 (AGENTS.md)

# Prisma Postgres 연결 문자열 (ADR-0013) — 둘 다 서버 전용
# 즉시 발급: npx create-db@latest   (24시간 임시. 출력된 claim URL로 클레임하면 영구 보존)
# 영구 DB:  https://console.prisma.io 에서 생성 후 pooled/direct 연결 문자열을 각각 복사
# 런타임은 풀러, 마이그레이션·Studio 같은 CLI는 direct 연결을 쓴다
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# 공공데이터포털 개인/프로젝트 서비스키 (서버 전용)
# API별 활용신청은 각각 필요하지만 승인 시 같은 키를 선택해 함께 사용한다.
PUBLIC_DATA_SERVICE_KEY=""
# 기상청 초단기실황 조회용 5km 격자좌표 (서버 전용)
KMA_GRID_NX=""
KMA_GRID_NY=""

# OpenAI Responses API (서버 전용) — 복지 스캔 설비·비식별 기록 신호 분류 (ADR-0020)
OPENAI_API_KEY=""

# 카카오맵 JavaScript SDK 앱 키 (클라이언트 노출 허용) — FR-6 지도 + FR-7 방문 동선
NEXT_PUBLIC_KAKAO_MAP_KEY=""

# 카카오 REST API 키 (서버 전용) — 지오코딩·FR-7 자동차 최단 경로
KAKAO_REST_KEY=""

# Web Push VAPID (ADR-0017) — 공개키만 클라이언트 노출 허용
# 생성: npm run push:keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# VAPID 연락처. mailto: 또는 https: URL
VAPID_SUBJECT="mailto:admin@example.com"
# 예약 발송 엔드포인트 Authorization: Bearer 토큰 (서버 전용)
CRON_SECRET=""
